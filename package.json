{
  "name": "dvg",
  "version": "4.3.0",
  "private": true,
  "author": "Rick Centerhall - https://www.linkedin.com/in/rickcenterhall/",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "svg": "svgr -d src/components/icons src/components/icons/svgs",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.mts",
    "test:unit": "vitest run src",
    "test:watch": "vitest",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "schema:pull": "bun scripts/fetch-wp-schema.ts && bun run codegen",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@headlessui/react": "^2.2.9",
    "@next/third-parties": "16.3.4",
    "@orama/orama": "^3.1.18",
    "@orama/stemmers": "^3.1.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.14",
    "html-react-parser": "^5.2.10",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-seo": "^6.8.0",
    "object.groupby": "^1.0.3",
    "postcss": "^8.5.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-to-print": "^3.2.0",
    "schema-dts": "^2.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "use-debounce": "^10.1.1",
    "uuid": "^13.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/client-preset": "^6.2.2",
    "@svgr/cli": "^8.1.0",
    "@types/bun": "^1.4.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "20.10.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/uuid": "^11.0.0",
    "graphql": "^17.0.2",
    "postcss-nesting": "^14.0.1",
    "tw-animate-css": "^1.4.0",
    "vitest": "^5.1.0"
  }
}
