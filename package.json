{
  "name": "dvg",
  "version": "4.5.1",
  "private": true,
  "author": "Rick Centerhall - https://www.linkedin.com/in/rickcenterhall/",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "svg": "svgr --jsx-runtime automatic --filename-case kebab --svg-props aria-hidden=true -d src/components/icons src/components/icons/svgs",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.mts",
    "test:unit": "vitest run src",
    "test:watch": "vitest",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "schema:pull": "bun scripts/fetch-wp-schema.ts && bun run codegen",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@next/third-parties": "16.4.6",
    "@orama/orama": "^3.1.18",
    "@orama/stemmers": "^3.1.18",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@vercel/blob": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.5.0",
    "html-react-parser": "^6.1.10",
    "lucide-react": "^1.82.0",
    "next": "16.4.6",
    "object.groupby": "^1.0.3",
    "postcss": "^8.5.34",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-to-print": "^3.2.0",
    "schema-dts": "^2.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.1",
    "@svgr/cli": "^8.1.0",
    "@types/bun": "^1.4.5",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "graphql": "^17.1.0",
    "postcss-nesting": "^14.0.3",
    "tw-animate-css": "^1.4.0",
    "vitest": "^5.1.2"
  }
}
